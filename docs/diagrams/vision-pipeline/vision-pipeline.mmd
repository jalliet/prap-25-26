flowchart LR
    OAK["OAK-D Camera<br/>1080p Sensor"]
    CS["CameraService<br/>DepthAI Pipeline<br/>1280×720 preview"]
    VC["VisionController<br/>QTimer @ FPS Hz"]

    CD["CardDetector<br/>YOLOv8"]
    CHI["ChipSegmentor<br/>YOLOv8 Seg"]
    PASS["Pass-through"]

    DEDUP["Dedup<br/>frozenset(rank,suit)"]
    DRAW["draw_card_detections()<br/>bbox + label overlay"]

    SIG_F["frame_ready signal"]
    SIG_C["cards_detected signal"]

    FEED["MainWindow<br/>Camera Feed QLabel"]
    LOG["MainWindow<br/>Game Log"]

    OAK --> CS
    CS -->|"get_frame()"| VC

    VC -->|"CARD_READING"| CD
    VC -->|"CHIP_SEG"| CHI
    VC -->|"IDLE"| PASS

    CD -->|"List&lt;CardDetection&gt;"| DEDUP
    CD -->|"detections"| DRAW
    DRAW -->|"annotated frame"| SIG_F

    DEDUP -->|"changed?"| SIG_C

    CHI -->|"ChipStack"| SIG_F
    PASS --> SIG_F

    SIG_F -->|"convert_cv_qt()"| FEED
    SIG_C --> LOG

    classDef camera fill:#4A90E2,stroke:#2B5C8A,color:#fff
    classDef detect fill:#E8A838,stroke:#A06B1F,color:#fff
    classDef signal fill:#50C878,stroke:#2D7A47,color:#fff
    classDef ui fill:#C75050,stroke:#8A2D2D,color:#fff

    class OAK,CS camera
    class CD,CHI,PASS detect
    class SIG_F,SIG_C,DEDUP,DRAW signal
    class MW,FEED,LOG ui
